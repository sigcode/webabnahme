#!/bin/zsh
# Rebuilds dist/Web-Abnahme.app before every commit and adds it, so the
# repository always carries the newest build. Skip once with: git commit --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "pre-commit: baue Web-Abnahme.app …"
if ! ./build-app.sh >/tmp/web-abnahme-build.log 2>&1; then
  echo "pre-commit: Build fehlgeschlagen – Commit abgebrochen (Details: /tmp/web-abnahme-build.log)"
  exit 1
fi
git add dist
